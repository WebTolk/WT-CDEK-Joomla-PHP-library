{
  "name": "WT Cdek library package",
  "version": "1.4.0",
  "root": "../..",
  "author": "Sergey Tolkachyov, WebTolk",
  "authorEmail": "info@web-tolk.ru",
  "link": "https://web-tolk.ru",
  "copyright": "Copyright (c) %s Sergey Tolkachyov, WebTolk. All rights reserved.",
  "projectDateStart": "2024",
  "packageDir": ".packages",
  "packageNamePattern": "{name}_{version}.zip",
  "phpStormCopyrightsPath": ".idea/copyright",
  "packageJsonPath": "build/package.json",
  "textExtensions": ["js"],
  "exclude": [
    ".apidoc.cdek.ru/",
    ".idea/",
    ".packages/",
    ".phing/",
    ".playwright-mcp/",
    ".webtolk/",
    ".docs/",
    "docs/",
    "build/",
    "build/node_modules/",
    ".gitignore",
    "LICENSE",
    "*.md"
  ],
  "replace": {
    "versionDocblock": true,
    "versionXml": true,
    "versionPackageJson": true,
    "dateDocblock": true,
    "dateXml": true,
    "creationDateXml": true,
    "author": true,
    "authorEmail": true,
    "link": true,
    "package": true,
    "copyright": true,
    "sinceResetToken": "__DEPLOY_VERSION__",
    "deployDateToken": "__DEPLOY_DATE__",
    "deployVersionToken": "__DEPLOY_VERSION__"
  }
}
